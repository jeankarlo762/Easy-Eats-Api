# Copie para docker/.env e ajuste. O .env não vai para o git.

# Usuário do Docker Hub e tag das imagens (repositório <usuario>/easy-eats).
DOCKERHUB_USERNAME=seu-usuario
TAG=latest

# Banco
DB_NAME=easyeats
DB_USERNAME=postgres
DB_PASSWORD=troque-esta-senha
DB_PORT=5432

# API — gere o segredo com: openssl rand -base64 64
JWT_SECRET=
BACKEND_PORT=8080

# Frontend
FRONTEND_PORT=4200
# Caminho do repositório do frontend, relativo a esta pasta docker/
FRONTEND_PATH=../../Easy-Eats
